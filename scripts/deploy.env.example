# Copy to scripts/deploy.env and fill in. That file is gitignored: never commit
# real credentials, and never paste them into a chat or an issue.
#
# Get these from hPanel -> Files -> FTP Accounts. Create a dedicated FTP account
# scoped to the site's directory rather than reusing the main account.

FTP_HOST=ftp.greatskills.org
FTP_USER=
FTP_PASS=

# Absolute path on the server. For the primary domain this is usually
# /public_html. For an addon domain it is /domains/<domain>/public_html.
FTP_REMOTE_DIR=/public_html
