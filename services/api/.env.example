# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself.
ENVIRONMENT=development

# Local dev with zero setup uses SQLite. For Postgres locally:
# DATABASE_URL=postgresql+asyncpg://greatskills:greatskills_dev_pw@localhost:5432/greatskills
DATABASE_URL=sqlite+aiosqlite:///./greatskills.db

# Generate a strong secret in production, e.g. `openssl rand -hex 32`
JWT_SECRET=dev-secret-change-me

REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
