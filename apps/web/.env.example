# Copy to .env.local for local dev, or set these in the CI environment for a
# production build. Vite inlines VITE_* vars at BUILD time, not run time, so a
# change here means a rebuild and redeploy, not just a server restart.
#
# Nothing secret belongs in this file. Anything prefixed VITE_ is compiled into
# the JavaScript bundle and is publicly readable by anyone who visits the site.

# Where the "Login" and "Join for Free" buttons point.
# Local default is http://localhost:5174; production should be the portal host.
VITE_PORTAL_URL=https://achievers.greatskills.org
